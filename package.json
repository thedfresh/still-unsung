{
  "name": "still-unsung",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "generate": "prisma generate && next typegen",
    "typecheck": "npm run generate && tsc --noEmit",
    "lint": "eslint --max-warnings=0",
    "build": "npm run typecheck && npm run lint && next build",
    "start": "next start",
    "test": "npm run test:unit && npm run test:component && npm run test:db",
    "test:unit": "vitest run --project unit",
    "test:component": "vitest run --project component",
    "test:db": "vitest run --project db",
    "test:e2e": "playwright test",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:deploy:test": "node --env-file=.env.test node_modules/prisma/build/index.js migrate deploy",
    "db:seed": "node --env-file=.env --disable-warning=MODULE_TYPELESS_PACKAGE_JSON prisma/seed/run.ts",
    "db:create-admin": "node --env-file=.env --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/create-admin.ts",
    "db:import-legacy": "node --env-file=.env --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/import-legacy/run.ts",
    "check": "npm run build && npm run test && npm run test:e2e",
    "db:content-model": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/content-model/generate.ts"
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.11.3",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "@simplewebauthn/browser": "^9.0.1",
    "@simplewebauthn/server": "^9.0.3",
    "next": "16.4.6",
    "next-auth": "^5.0.0-beta.32",
    "pg": "^8.23.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.65.0",
    "@tailwindcss/turbopack": "4.3.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.13",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^18.0.10",
    "eslint": "^10.14.0",
    "eslint-config-next": "16.4.6",
    "eslint-plugin-check-file": "^3.3.2",
    "jsdom": "^31.0.1",
    "prisma": "^7.10.1",
    "tailwindcss": "4.3.3",
    "typescript": "^5.9.3",
    "vitest": "^5.1.0"
  },
  "engines": {
    "node": ">=26 <27"
  }
}
