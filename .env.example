# Copy to .env and adjust. Local Postgres 18 on port 5433 (see README).
DATABASE_URL="postgresql://still_unsung:still_unsung@localhost:5433/still_unsung_dev"

# Import from the old database (npm run db:import-legacy; see the README). The old copy is
# read only. The output folder must be outside this repository: it holds private notes.
LEGACY_DATABASE_URL="postgresql://localhost:5433/hunter_archive_old"
# LEGACY_SCHEMA="public"
IMPORT_OUTPUT_DIR=""
ZOTERO_KEY_LEGACY_SETLIST_LIST=""
ZOTERO_KEY_GDSETS=""
ZOTERO_KEY_WHITEGUM=""
# Sign-in emails of the two accounts. Optional; leave them out to make no account.
# CURATOR_EMAIL is also the email that `npm run db:create-admin` makes an ADMIN user for.
CURATOR_EMAIL=""
AGENT_EMAIL=""

# Sign-in (Auth.js). Make the secret with: openssl rand -base64 32
AUTH_SECRET=""
# Google OAuth client. In the Google console, allow the redirect URI
# http://localhost:3000/api/auth/callback/google (and the staging and prod addresses).
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""
# Set to true only behind the proxy (staging, prod), so Auth.js trusts the Host header.
# AUTH_TRUST_HOST="true"
# The site's own address. The agent's preview text ends with a link built from it, for example
# https://staging.stillunsung.com. With no value, the preview has no link.
# AUTH_URL=""
