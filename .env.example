# Copy to .env and adjust. Local Postgres 18 on port 5433 (see README).
DATABASE_URL="postgresql://still_unsung:still_unsung@localhost:5433/still_unsung_dev"

# Import from the old database (npm run db:import-legacy; see the README). The old copy is
# read only. The output folder must be outside this repository: it holds private notes.
LEGACY_DATABASE_URL="postgresql://localhost:5433/hunter_archive_old"
# LEGACY_SCHEMA="public"
IMPORT_OUTPUT_DIR=""
ZOTERO_KEY_LEGACY_SETLIST_LIST=""
ZOTERO_KEY_GDSETS=""
ZOTERO_KEY_WHITEGUM=""
# Sign-in emails of the two accounts. Optional; leave them out to make no account.
CURATOR_EMAIL=""
AGENT_EMAIL=""
